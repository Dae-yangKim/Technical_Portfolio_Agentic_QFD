# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다.
#   cp .env.example .env

# ── collection/ (Reddit 수집) ── https://www.reddit.com/prefs/apps 에서 "script" 앱 생성
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:review_collection:v1.0 (by /u/your_username)

# ── pipeline/ (Stage 0~3) ── LLM 호출·임베딩
OPENAI_API_KEY=

# ── pipeline/ Stage 1~3 에이전트 검색 도구
TAVILY_API_KEY=
SERPAPI_API_KEY=
